# Taps are declared directly above the formula that needs them, so each group
# is self-contained and groups can be reordered freely.

# ------------------------------------------------
# Shell & Terminal
# ------------------------------------------------

# GPU-accelerated cross-platform terminal emulator and multiplexer
cask "wezterm"

# GPU-accelerated terminal emulator focused on speed and native UI
cask "ghostty"

# Terminal multiplexer
brew "tmux"

# Shell extension to navigate your filesystem faster
brew "zoxide"

# Command-line fuzzy finder written in Go
brew "fzf"

# ------------------------------------------------
# CLI Utilities
# ------------------------------------------------

# Simple, fast and user-friendly alternative to find
brew "fd"

# Search tool like grep and The Silver Searcher
brew "ripgrep"

# Display directories as trees (with optional color/HTML output)
brew "tree"

# Shell information (runs at shell startup via OMZ setup)
brew "fastfetch"

# Command-line password manager (GPG-encrypted password store)
brew "pass"

# ------------------------------------------------
# Editors & IDEs
# ------------------------------------------------

# Ambitious Vim-fork focused on extensibility and agility
brew "neovim"

# Treesitter CLI for NeoVim
brew "tree-sitter-cli"

# Package manager for the Lua programming language (used by NeoVim plugins)
brew "luarocks"

# Extensible source-code editor from Microsoft
cask "visual-studio-code"

# App for installing and updating JetBrains IDEs
cask "jetbrains-toolbox"

# ------------------------------------------------
# Git & GitHub
# ------------------------------------------------

# GitHub command-line tool
brew "gh"

# Simple terminal UI for git commands
brew "lazygit"

# Good-lookin' diffs with diff-highlight and more
brew "diff-so-fancy"

# An opinionated workflow tool that orchestrates git worktrees and tmux
tap "raine/workmux"
brew "raine/workmux/workmux", trusted: true

# ------------------------------------------------
# Languages & Runtimes
# ------------------------------------------------

# Manage multiple Node.js versions
brew "nvm"

# Fast Python package and project manager
brew "uv"

# ------------------------------------------------
# Containers, VMs & Databases
# ------------------------------------------------

# Orchestrates virtual Ubuntu instances
cask "multipass"

# Terminal UI for managing Docker containers and images
brew "lazydocker"

# Postgres CLI client with autocompletion and syntax highlighting
brew "pgcli"

# ------------------------------------------------
# AI Tooling
# ------------------------------------------------

# Anthropic's agentic coding tool for the terminal
cask "claude-code"

# ------------------------------------------------
# Documents & Media
# ------------------------------------------------

# Compact TeX distribution as alternative to the full TeX Live / MacTeX
cask "basictex"

# Interpreter for PostScript and PDF
brew "ghostscript"

# Tools and libraries to manipulate images in select formats
brew "imagemagick"

# Media viewer
cask "vlc"

# ------------------------------------------------
# Fonts
# ------------------------------------------------

# GitHub Monaspace font
cask "font-monaspace-nf"

# ------------------------------------------------
# macOS Utilities
# ------------------------------------------------

# Bluetooth helper (to connect AirPods)
brew "blueutil"

# Tool for managing dock items
brew "dockutil"

# System monitor for the menu bar
cask "stats"

# ------------------------------------------------
# Apps
# ------------------------------------------------

# Web browser
cask "firefox"

# Video communication and virtual meeting platform
cask "zoom"

# ------------------------------------------------
# Fun
# ------------------------------------------------

# Terminal matrix screensaver
brew "cmatrix"

# Music for programming
tap "fpigeonjr/homebrew-tap"
brew "fpigeonjr/homebrew-tap/mfp", trusted: true
